FROM python:3.12.14 AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY requirements.txt ./
RUN python -m venv .venv && .venv/bin/pip install --no-cache-dir -r requirements.txt

FROM python:3.12.14-slim-bookworm
WORKDIR /app
COPY --from=builder /app/.venv .venv/
COPY . .

# The isolated catalog pilot runs one durable SQLite queue worker inside the
# same machine as the API. No Redis, extra Fly machine, or paid service needed.
RUN /app/.venv/bin/playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
CMD ["sh", "-c", "cd /app/backend; /app/.venv/bin/python -m app.workers.sqlite_worker & INGESTION_PID=$!; trap 'kill $INGESTION_PID 2>/dev/null || true; wait $INGESTION_PID 2>/dev/null || true; exit 143' TERM INT; /app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080"]
