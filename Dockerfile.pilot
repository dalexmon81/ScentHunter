FROM python:3.12.14 AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY requirements.txt ./
RUN python -m venv .venv && .venv/bin/pip install --no-cache-dir -r requirements.txt

FROM python:3.12.14-slim-bookworm
WORKDIR /app
COPY --from=builder /app/.venv .venv/
COPY . .

# The isolated catalog pilot is catalog-first and does not launch a browser.
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

# Apply migrations and seed canonical identities before API/worker startup.
# Retailer activation and feed import remain explicit steps in the pilot workflow.
# Fail startup on any migration/seed error; never serve an empty partial catalog.
CMD ["sh", "-c", "set -eu; cd /app/backend; /app/.venv/bin/python scripts/bootstrap_catalog.py; /app/.venv/bin/python -m app.workers.sqlite_worker & INGESTION_PID=$!; trap 'kill $INGESTION_PID 2>/dev/null || true; wait $INGESTION_PID 2>/dev/null || true; exit 143' TERM INT; /app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080"]
