FROM python:3.12.14 AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY requirements.txt ./
RUN python -m venv .venv && .venv/bin/pip install --no-cache-dir -r requirements.txt

FROM python:3.12.14-slim-bookworm
WORKDIR /app
COPY --from=builder /app/.venv .venv/
COPY . .

# The isolated catalog pilot is catalog-first: API search reads canonical
# SQLite data and ingestion uses the CJ feed connector. Neither path launches
# a browser. Keep Chromium/OS browser dependencies out of this image so Fly's
# remote build does not spend its deploy window downloading a browser runtime.
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
# API-only pilot: startup must not launch automatic catalog discovery/hydration.
ENV SCENTHUNTER_DISABLE_AUTOMATIC_CATALOG_STARTUP=1

# Migrate and seed the mounted canonical DB before either process starts.
# Bootstrap is idempotent and preserves operator-disabled/quarantined stores.
# If bootstrap fails, fail the deploy rather than serving an empty/broken API.
CMD ["sh", "-c", "set -eu; cd /app/backend; /app/.venv/bin/python scripts/bootstrap_catalog.py; if [ \"${SCENTHUNTER_ENABLE_SQLITE_WORKER:-0}\" = \"1\" ]; then /app/.venv/bin/python scripts/seed_notino_store.py --confirm; /app/.venv/bin/python -m app.workers.sqlite_worker & echo \"SCENTHUNTER_SQLITE_WORKER_STARTED pid=$!\"; fi; exec /app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080"]
