"""ScentHunter read-only search concurrency diagnostic."""
import importlib
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from fastapi import APIRouter

router = APIRouter()


def _catalog():
    return importlib.import_module("catalog_engine")


def _snapshot(catalog):
    cache = getattr(catalog, "_LOCAL_SEARCH_INDEX_CACHE", {})
    out = {}
    for store, item in cache.items():
        sig = item.get("signature", ())
        out[store] = {
            "signature": list(sig),
            "url_count": len(item.get("url_tokens", {})),
            "posting_count": len(item.get("postings", {})),
        }
    return out


def _lock_state(lock):
    try:
        return bool(lock.locked())
    except Exception:
        return None


@router.get("/diagnostic/search-concurrency")
def diagnostic_search_concurrency(
    q: str = "Liquid Brun",
    timeout_seconds: float = 12.0,
):
    """Run two search_local calls without waiting indefinitely.

    SQLite is never written. Discovery/hydration are not called.
    """
    started = time.perf_counter()

    try:
        catalog = _catalog()
    except Exception as exc:
        return {
            "ok": False,
            "diagnostic": "search-concurrency-v3",
            "error": f"{type(exc).__name__}: {exc}",
        }

    search_local = getattr(catalog, "search_local", None)
    lock = getattr(catalog, "_LOCAL_SEARCH_INDEX_LOCK", None)

    if not callable(search_local) or lock is None:
        return {
            "ok": False,
            "diagnostic": "search-concurrency-v3",
            "error": "search_local_or_lock_unavailable",
        }

    samples = []
    stop = threading.Event()

    def sampler():
        while not stop.is_set():
            samples.append({
                "elapsed": round(time.perf_counter() - started, 4),
                "lock_locked": _lock_state(lock),
                "cache": _snapshot(catalog),
            })
            time.sleep(0.05)

    sampler_thread = threading.Thread(
        target=sampler,
        name="diagnostic-search-concurrency-sampler",
        daemon=True,
    )
    sampler_thread.start()

    def run_one():
        t0 = time.perf_counter()
        cpu0 = time.thread_time()
        try:
            rows = search_local(q, per_store=64, search_terms=[q])
            return {
                "finished": True,
                "seconds": round(time.perf_counter() - t0, 4),
                "thread_cpu_seconds": round(time.thread_time() - cpu0, 4),
                "result_count": len(rows),
                "error": None,
            }
        except Exception as exc:
            return {
                "finished": True,
                "seconds": round(time.perf_counter() - t0, 4),
                "thread_cpu_seconds": round(time.thread_time() - cpu0, 4),
                "result_count": 0,
                "error": f"{type(exc).__name__}: {exc}",
            }

    executor = ThreadPoolExecutor(
        max_workers=2,
        thread_name_prefix="diagnostic-search",
    )

    futures = [
        executor.submit(run_one),
        executor.submit(run_one),
    ]

    results = []
    deadline = time.perf_counter() + max(1.0, float(timeout_seconds))

    for future in futures:
        remaining = max(0.0, deadline - time.perf_counter())
        try:
            results.append(future.result(timeout=remaining))
        except TimeoutError:
            results.append({
                "finished": False,
                "timeout": True,
            })
        except Exception as exc:
            results.append({
                "finished": False,
                "timeout": False,
                "error": f"{type(exc).__name__}: {exc}",
            })

    # Do NOT wait for stuck search threads.
    stop.set()
    sampler_thread.join(timeout=0.2)
    executor.shutdown(wait=False, cancel_futures=True)

    lock_samples = [s for s in samples if s["lock_locked"]]

    signature_sets = {}
    for sample in samples:
        for store, data in sample["cache"].items():
            signature_sets.setdefault(store, set()).add(
                tuple(data["signature"])
            )

    signature_changes = {
        store: [list(sig) for sig in values]
        for store, values in signature_sets.items()
        if len(values) > 1
    }

    finished = [r for r in results if r.get("finished")]
    timed_out = [r for r in results if r.get("timeout")]

    return {
        "ok": len(timed_out) == 0 and all(
            r.get("error") is None for r in finished
        ),
        "diagnostic": "search-concurrency-v3",
        "query": q,
        "writes_to_sqlite": False,
        "timeout_seconds": timeout_seconds,
        "total_seconds": round(time.perf_counter() - started, 4),
        "concurrent": {
            "search_1": results[0],
            "search_2": results[1],
        },
        "lock": {
            "locked_sample_count": len(lock_samples),
            "sample_count": len(samples),
            "lock_observed_ratio": round(
                len(lock_samples) / len(samples), 4
            ) if samples else 0,
        },
        "cache": {
            "signature_changes_during_test": signature_changes,
            "final": _snapshot(catalog),
        },
        "sampler": {
            "samples": len(samples),
            "interval_seconds": 0.05,
        },
        "diagnosis": (
            "SEARCH_LOCAL_TIMEOUT_OR_CONTENTION"
            if timed_out
            else (
                "CONCURRENT_SEARCH_LOCK_CONTENTION"
                if max(
                    (r.get("seconds", 0) for r in finished),
                    default=0,
                ) > 1.0
                else "NO_MAJOR_CONCURRENT_CONTENTION_OBSERVED"
            )
        ),
    }
