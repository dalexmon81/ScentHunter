This endpoint only observes:

  1. the public Deloox search surface;
  2. the deployed Deloox scraper discovery path;
  3. the catalog URL admission helpers;
  4. persistent SQLite catalog/frontier state;
  5. direct product-page parsing.

It does NOT call:

  - production /search
  - ProductMatcher
  - discover_store()
  - sync/resync
  - catalog repair
  - hydration workers
  - any database write

The target product URL is discovered from the retailer surface.
No product ID, name, alias, variant, or SKU is hardcoded.
"""

started = time.monotonic()

query = str(q or "").strip() or "Rasasi Hawas Atlantis"

out = {
    "diagnostic": "deloox-catalog-gap-final-v2",
    "ok": False,
    "store": "deloox",
    "query": query,

    "writes": False,
    "catalog_written": False,
    "resync": False,
    "repair_called": False,
    "hydration_started": False,
    "production_search_called": False,
    "product_matcher_called": False,

    "checks": {},
}

session = None

try:
    import requests
    import catalog_engine
    from scrapers.deloox import scraper

    db_fn = getattr(
        catalog_engine,
        "db",
        None,
    )

    product_url_fn = getattr(
        catalog_engine,
        "_html_product_url",
        None,
    )

    listing_url_fn = getattr(
        catalog_engine,
        "_html_listing_url",
        None,
    )

    discover_fn = getattr(
        scraper,
        "_discover",
        None,
    )

    candidate_fn = getattr(
        scraper,
        "_candidate_product_urls",
        None,
    )

    product_fn = getattr(
        scraper,
        "_product",
        None,
    )

    if not callable(db_fn):
        out["error"] = "catalog_db_unavailable"
        return out

    if not callable(candidate_fn):
        out["error"] = (
            "deloox_candidate_product_urls_unavailable"
        )
        return out

    # ------------------------------------------------------------
    # HTTP SESSION
    # ------------------------------------------------------------

    session = requests.Session()

    headers = getattr(
        scraper,
        "HEADERS",
        {
            "User-Agent": (
                "Mozilla/5.0 (X11; Linux x86_64) "
                "AppleWebKit/537.36 Chrome/131 Safari/537.36"
            ),
            "Accept": (
                "text/html,application/xhtml+xml,"
                "application/json;q=0.9,*/*;q=0.8"
            ),
            "Accept-Language": "en-GB,en;q=0.9",
        },
    )

    session.headers.update(headers)

    # ============================================================
    # 1. PUBLIC DELOOX SEARCH
    # ============================================================
    #
    # This step is READ-ONLY.
    #
    # The diagnostic does not assume the product ID.
    # It derives the product URL from the retailer search page.
    # ============================================================

    search_url = (
        "https://www.deloox.be/chercher.html?q="
        + urllib.parse.quote_plus(query)
    )

    public_check = {
        "url": search_url,
        "status": None,
        "candidate_product_urls": [],
        "target_url": None,
        "target_product_id": None,
        "target_url_found": False,
        "error": None,
    }

    try:
        response = session.get(
            search_url,
            headers=headers,
            timeout=(5, 15),
            allow_redirects=True,
        )

        public_check["status"] = response.status_code

        if response.status_code < 400:

            found = list(
                candidate_fn(
                    response.text,
                    query,
                    discovery_query=query,
                    accept_all_products=True,
                    base_url=_base_url(response.url),
                )
                or []
            )

            public_check[
                "candidate_product_urls"
            ] = found[:100]

            # We only identify a target from an actual Deloox
            # product URL exposed by the retailer.
            #
            # No product ID is hardcoded.
            for url in found:

                if DELOOX_PRODUCT_ID_RE.search(
                    str(url or "")
                ):

                    public_check["target_url"] = url

                    public_check[
                        "target_product_id"
                    ] = _target_product_id(url)

                    public_check[
                        "target_url_found"
                    ] = True

                    break

    except Exception as exc:

        public_check["error"] = (
            f"{type(exc).__name__}: {exc}"
        )

    out["checks"]["public_search"] = public_check

    target_url = public_check["target_url"]

    # ============================================================
    # 2. DEPLOYED SCRAPER DISCOVERY
    # ============================================================
    #
    # IMPORTANT:
    # _discover() is called here only to observe what the deployed
    # scraper returns for the supplied query.
    #
    # It is NOT the catalog discovery engine.
    # It does not write to the catalog database.
    #
    # We do not call catalog_engine.discover_store().
    # ============================================================

    discover_check = {
        "available": callable(discover_fn),
        "candidate_count": 0,
        "candidate_urls": [],
        "target_url_found": False,
        "target_url": target_url,
        "error": None,
    }

    if callable(discover_fn):

        try:

            discovered = list(
                discover_fn(
                    session,
                    query,
                )
                or []
            )

            discover_check[
                "candidate_count"
            ] = len(discovered)

            discover_check[
                "candidate_urls"
            ] = discovered[:100]

            for url in discovered:

                if _same_product_url(
                    url,
                    target_url,
                ):

                    discover_check[
                        "target_url_found"
                    ] = True

                    discover_check[
                        "target_url"
                    ] = url

                    break

        except Exception as exc:

            discover_check["error"] = (
                f"{type(exc).__name__}: {exc}"
            )

    out["checks"]["scraper_discover"] = (
        discover_check
    )

    # ============================================================
    # 3. CATALOG URL ADMISSION
    # ============================================================
    #
    # We call only the pure URL admission helpers.
    #
    # No discovery worker is executed.
    # No catalog write occurs.
    # ============================================================

    admission_check = {
        "target_url": target_url,

        "html_product_url_available": (
            callable(product_url_fn)
        ),

        "html_listing_url_available": (
            callable(listing_url_fn)
        ),

        "product_admitted": False,
        "listing_admitted": False,

        "product_result": None,
        "listing_result": None,

        "error": None,
    }

    if (
        target_url
        and callable(product_url_fn)
    ):

        try:

            base = _base_url(target_url)

            admission_check[
                "product_result"
            ] = product_url_fn(
                "deloox",
                target_url,
                base,
            )

            admission_check[
                "product_admitted"
            ] = bool(
                admission_check[
                    "product_result"
                ]
            )

            if callable(listing_url_fn):

                admission_check[
                    "listing_result"
                ] = listing_url_fn(
                    "deloox",
                    target_url,
                    base,
                    query,
                )

                admission_check[
                    "listing_admitted"
                ] = bool(
                    admission_check[
                        "listing_result"
                    ]
                )

        except Exception as exc:

            admission_check["error"] = (
                f"{type(exc).__name__}: {exc}"
            )

    out["checks"]["catalog_url_admission"] = (
        admission_check
    )

    # ============================================================
    # 4. PERSISTENT CATALOG STATE
    # ============================================================
    #
    # READ-ONLY SQL.
    #
    # We inspect:
    #
    #   store_urls
    #   hydration_queue
    #   catalog_discovery_queue
    #
    # No INSERT / UPDATE / DELETE is performed.
    # ============================================================

    db_check = {
        "exact_store_url": [],
        "exact_hydration": [],
        "discovery_queue_matches": [],
        "discovery_queue_match_count": 0,
        "error": None,
    }

    conn = db_fn()

    try:

        if target_url:

            # ----------------------------------------------------
            # store_urls
            # ----------------------------------------------------

            exact = conn.execute(
                """
                SELECT
                    store,
                    url,
                    slug,
                    lastmod,
                    discovered_at,
                    active
                FROM store_urls
                WHERE store = 'deloox'
                  AND url = ?
                ORDER BY url
                """,
                (
                    target_url,
                ),
            ).fetchall()

            db_check[
                "exact_store_url"
            ] = [
                dict(row)
                for row in exact
            ]

            # ----------------------------------------------------
            # hydration_queue
            # ----------------------------------------------------

            hydration = conn.execute(
                """
                SELECT
                    store,
                    url,
                    state,
                    attempts,
                    last_error,
                    last_http_status,
                    last_started_at,
                    last_finished_at
                FROM hydration_queue
                WHERE store = 'deloox'
                  AND url = ?
                ORDER BY url
                """,
                (
                    target_url,
                ),
            ).fetchall()

            db_check[
                "exact_hydration"
            ] = [
                dict(row)
                for row in hydration
            ]

            # ----------------------------------------------------
            # catalog_discovery_queue
            # ----------------------------------------------------
            #
            # Use the product ID derived from the discovered URL.
            # This is observational and not a catalog rule.
            # ----------------------------------------------------

            target_id = _target_product_id(
                target_url
            )

            if target_id:

                frontier = conn.execute(
                    """
                    SELECT
                        store,
                        url,
                        depth,
                        source,
                        state,
                        attempts,
                        available_at,
                        last_started_at,
                        last_finished_at,
                        last_error
                    FROM catalog_discovery_queue
                    WHERE store = 'deloox'
                      AND (
                          lower(url) LIKE ?
                          OR lower(source) LIKE ?
                      )
                    ORDER BY depth ASC, url ASC
                    LIMIT 100
                    """,
                    (
                        f"%{target_id.lower()}%",
                        f"%{target_id.lower()}%",
                    ),
                ).fetchall()

            else:

                frontier = []

            db_check[
                "discovery_queue_matches"
            ] = [
                dict(row)
                for row in frontier
            ]

            db_check[
                "discovery_queue_match_count"
            ] = len(frontier)

    finally:

        conn.close()

    out["checks"]["persistent_catalog"] = (
        db_check
    )

    # ============================================================
    # 5. DIRECT PRODUCT PAGE VALIDATION
    # ============================================================
    #
    # READ-ONLY HTTP request.
    #
    # This does not hydrate the catalog.
    # It does not write the hydration queue.
    # It only checks whether the existing Deloox product parser
    # can interpret the page.
    # ============================================================

    validation = {
        "target_url": target_url,
        "http_status": None,
        "final_url": None,
        "bytes": 0,
        "parser_available": callable(product_fn),
        "parsed_product": None,
        "error": None,
    }

    if target_url:

        try:

            response = session.get(
                target_url,
                headers=headers,
                timeout=getattr(
                    scraper,
                    "TIMEOUT",
                    (5, 15),
                ),
                allow_redirects=True,
            )

            validation[
                "http_status"
            ] = response.status_code

            validation[
                "final_url"
            ] = response.url

            validation[
                "bytes"
            ] = len(
                response.content or b""
            )

            if (
                response.status_code < 400
                and callable(product_fn)
            ):

                item = product_fn(
                    response.url or target_url,
                    response.text,
                    query,
                )

                if item:

                    validation[
                        "parsed_product"
                    ] = {
                        "name": item.get(
                            "name"
                        ),

                        "brand": (
                            item.get(
                                "source",
                                {}
                            )
                            if isinstance(
                                item.get(
                                    "source"
                                ),
                                dict,
                            )
                            else {}
                        ).get(
                            "source_brand"
                        ),

                        "size_ml": (
                            item.get(
                                "attributes",
                                {}
                            )
                            if isinstance(
                                item.get(
                                    "attributes"
                                ),
                                dict,
                            )
                            else {}
                        ).get(
                            "size_ml"
                        ),

                        "url": (
                            response.url
                            or target_url
                        ),
                    }

        except Exception as exc:

            validation["error"] = (
                f"{type(exc).__name__}: {exc}"
            )

    out["checks"][
        "direct_product_validation"
    ] = validation

    # ============================================================
    # FINAL DIAGNOSIS
    # ============================================================

    public_ok = bool(
        public_check.get(
            "target_url_found"
        )
    )

    scraper_ok = bool(
        discover_check.get(
            "target_url_found"
        )
    )

    admission_ok = bool(
        admission_check.get(
            "product_admitted"
        )
    )

    store_url_ok = bool(
        db_check.get(
            "exact_store_url"
        )
    )

    queue_matches = int(
        db_check.get(
            "discovery_queue_match_count"
        )
        or 0
    )

    parsed_ok = bool(
        validation.get(
            "parsed_product"
        )
    )

    # ------------------------------------------------------------
    # ROOT CAUSE: URL ADMISSION
    # ------------------------------------------------------------

    if (
        public_ok
        and scraper_ok
        and not admission_ok
    ):

        diagnosis = (
            "ROOT_CAUSE_URL_ADMISSION: "
            "public Deloox search and the deployed "
            "scraper both expose the same product URL, "
            "but catalog_engine._html_product_url() "
            "does not admit it."
        )

    # ------------------------------------------------------------
    # ROOT CAUSE: PERSISTENCE AFTER FRONTIER
    # ------------------------------------------------------------

    elif (
        public_ok
        and scraper_ok
        and admission_ok
        and not store_url_ok
    ):

        if queue_matches:

            diagnosis = (
                "ROOT_CAUSE_CATALOG_PERSISTENCE_AFTER_FRONTIER: "
                "the target URL is discoverable and admitted, "
                "related frontier state exists, but the exact "
                "URL is absent from store_urls."
            )

        else:

            diagnosis = (
                "ROOT_CAUSE_DISCOVERY_GRAPH: "
                "the target URL is publicly discoverable, "
                "is returned by the deployed scraper, and "
                "is admitted by catalog_engine, but there is "
                "no matching persistent discovery-frontier "
                "entry and no store_urls row."
            )

    # ------------------------------------------------------------
    # ROOT CAUSE: HYDRATION / PRODUCT PARSE
    # ------------------------------------------------------------

    elif (
        store_url_ok
        and not parsed_ok
    ):

        diagnosis = (
            "ROOT_CAUSE_HYDRATION_OR_PRODUCT_PARSE: "
            "the target URL is already in store_urls, "
            "but direct product parsing did not produce "
            "a product record."
        )

    # ------------------------------------------------------------
    # CATALOG PATH ALREADY PRESENT
    # ------------------------------------------------------------

    elif (
        store_url_ok
        and parsed_ok
    ):

        diagnosis = (
            "CATALOG_PATH_ALREADY_PRESENT: "
            "the target URL exists in the persistent "
            "catalog and the direct Deloox parser returns data."
        )

    # ------------------------------------------------------------
    # ROOT CAUSE: SCRAPER DISCOVERY
    # ------------------------------------------------------------

    elif (
        public_ok
        and not scraper_ok
    ):

        diagnosis = (
            "ROOT_CAUSE_SCRAPER_DISCOVERY: "
            "public Deloox search exposes the target URL "
            "but deployed _discover() does not return it."
        )

    # ------------------------------------------------------------
    # PUBLIC SEARCH DID NOT PROVIDE A TARGET
    # ------------------------------------------------------------

    elif not public_ok:

        diagnosis = (
            "PUBLIC_SEARCH_NO_TARGET: "
            "this read-only diagnostic did not derive "
            "a Deloox product URL from the public search surface."
        )

    # ------------------------------------------------------------
    # OTHERWISE
    # ------------------------------------------------------------

    else:

        diagnosis = (
            "INCONCLUSIVE: "
            "the read-only checks do not isolate one "
            "failure point."
        )

    out["diagnosis"] = diagnosis

    out["summary"] = {
        "public_search_finds_target": public_ok,
        "scraper_discover_finds_target": scraper_ok,
        "catalog_engine_admits_target": admission_ok,
        "persistent_store_urls_contains_target": (
            store_url_ok
        ),
        "discovery_frontier_has_related_entry": (
            queue_matches > 0
        ),
        "direct_product_parser_succeeds": (
            parsed_ok
        ),
    }

    out["ok"] = True

    return out

except Exception as exc:

    out["error"] = (
        f"{type(exc).__name__}: {exc}"
    )

    return out

finally:

    if session is not None:
        session.close()

    out["elapsed_sec"] = round(
        time.monotonic() - started,
        3,
    )
